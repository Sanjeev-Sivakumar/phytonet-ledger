  "description": "PhytoNet Ledger (PNL) - Proof-of-Vascular-Integrity Decentralized Bio-Carbon Engine for IEEE ClimateChain",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"green,cyan\" \"npm run server\" \"npm run client\"",
